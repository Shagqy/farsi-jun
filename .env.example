# Kopieren nach .env (lokal) bzw. in Vercel unter Settings → Environment Variables eintragen.

# Pflicht: Anthropic (KI-Partner, Korrektur, Lektionen) – https://console.anthropic.com
ANTHROPIC_API_KEY=

# Pflicht für Konten & Speicherung: Supabase – Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Nur diese E-Mails dürfen die KI nutzen (Komma-getrennt)
ALLOWED_EMAILS=

# Empfohlen: persische Stimme über Azure Speech (kostenlose Stufe F0 reicht)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# AZURE_VOICE=fa-IR-DilaraNeural   (männlich: fa-IR-FaridNeural)

# Empfohlen: Spracherkennung für gesprochenes Persisch – https://platform.openai.com
OPENAI_API_KEY=
# STT_MODEL=gpt-4o-transcribe

# Optional: andere Claude-Modelle
# MODEL_QUICK=claude-haiku-5-5
# MODEL_DEFAULT=claude-sonnet-5-5
# MODEL_COMPLEX=claude-sonnet-5-5
